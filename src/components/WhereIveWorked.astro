---
// Data lives in src/data/experience.json. `company` and `dates` are
// required; `title`, `summary`, and `tech` are optional — entries render
// cleanly without them rather than fabricating a role/description that
// wasn't provided. Shape:
//   { "company": "...", "dates": "...", "title"?: "...", "summary"?: "...", "tech"?: ["..."] }
import IconTech from "./IconTech.astro";
import SplitHeading from "./SplitHeading.astro";
import experience from "../data/experience.json";
---

<section class="experience" id="experience" data-recede>
  <div class="experience__inner">
    <SplitHeading text="Where I've Worked" tag="h2" class="experience__heading" />

    {experience.length === 0 ? (
      <div class="experience__placeholder" data-reveal>
        <p class="meta">[CONTENT NEEDED]</p>
        <p>
          Employment history isn't wired in yet — add entries to
          <code>src/data/experience.json</code> and the timeline below builds
          itself automatically.
        </p>
      </div>
    ) : (
      <ol class="timeline">
        {experience.map((entry) => (
          <li class="timeline__entry" data-reveal data-reveal-group="experience">
            <div class="timeline__marker" aria-hidden="true"></div>
            <div class="timeline__content">
              <div class="timeline__header">
                <IconTech name={entry.company} kind="company" label={`${entry.company} — ${entry.dates}${entry.title ? ` · ${entry.title}` : ""}`} />
                <span class="timeline__dates meta" aria-hidden="true">{entry.dates}</span>
              </div>
              {entry.summary && <p class="timeline__summary">{entry.summary}</p>}
              {entry.tech?.length > 0 && (
                <ul class="timeline__tags">
                  {entry.tech.map((t) => (
                    <li class="meta timeline__tag">{t}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    )}
  </div>
</section>

<style>
  .experience {
    /* min-height + centering shared with every other content section (see
       Hero.astro / AboutMe.astro) so section heights read as consistent
       instead of purely content-driven. 100dvh after 100vh (unsupported
       browsers just keep the 100vh rule) tracks Safari's collapsing
       address bar instead of the larger static viewport, which matters
       here because this section is the one most likely to overflow one
       screen on a phone. */
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-24) var(--space-6);
    /* Page-by-page scroll (see html's scroll-snap-type in base.css). */
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  @media (max-width: 767px) {
    .experience {
      /* Three timeline entries (dates + summary each) plus the original
         space-24 padding routinely ran taller than one phone screen, so
         the mandatory snap landed at the section's top but left content
         below the fold — reaching it, then the next section, took an
         extra manual scroll. Tighter padding and top-alignment (instead
         of vertical centering, which only makes overflow worse) gets the
         whole entry list to fit in one view on most phones. */
      padding: var(--space-12) var(--space-4);
      justify-content: flex-start;
    }
  }

  @media (max-height: 700px) {
    .experience {
      /* Overflow here is a height problem, not a width one — a short
         phone (e.g. iPhone SE at 667px tall) still ran past one screen
         even after the max-width trim above, cutting off the last entry.
         Targets short viewports specifically, independent of how wide
         they are. */
      padding: var(--space-8) var(--space-4);
    }
  }

  @media (min-width: 1024px) {
    .experience {
      padding: var(--space-40) var(--space-16);
    }
  }

  .experience__inner {
    /* Centered in the viewport, consistently with every other section (see
       Hero.astro for the full rationale). Also widened from the reading
       (760px) container to the full container-max, matching every other
       section's width — a narrower block centered on its own still landed
       at a different left edge than the wider sections, which is the same
       inconsistency this is fixing, just from a different cause. Timeline
       entries (dates, short summaries) don't need paragraph-width line
       constraints the way Contact's bio text does.
       width:100% is load-bearing now that .experience is a flex column
       (for vertical centering) — see the matching comment in
       AboutMe.astro for why a flex item with margin:auto and no explicit
       width shrink-wraps instead of filling the container. This section's
       own content (just a logo per entry) is narrow enough that without
       this, it was visibly shrink-wrapping and centering itself while
       wider sections weren't — exactly the "left aligned vs. centered"
       inconsistency reported. */
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .experience__placeholder {
    border: 1px dashed var(--color-border);
    padding: var(--space-8);
    color: var(--color-text-muted);
  }

  .experience__placeholder p:first-child {
    color: var(--color-warning);
    margin-bottom: var(--space-2);
  }

  .timeline {
    /* Capped narrower than .experience__inner for readable line lengths on
       summary text — same pattern as Contact's bio paragraph. The outer
       box still governs shared alignment with other sections; this only
       constrains the content's own width, not its position. */
    max-width: var(--container-reading);
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  /* The vertical spine, offset to align with each marker's center */
  .timeline::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--color-border);
  }

  .timeline__entry {
    /* space-16 (was space-12) — more breathing room between entries, using
       an existing scale token rather than a one-off value so it stays
       consistent with the rest of the design system. */
    position: relative;
    padding-left: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .timeline__entry:last-child {
    padding-bottom: 0;
  }

  @media (max-width: 767px) {
    .timeline__entry {
      /* Tighter than desktop's space-16 — see .experience's mobile media
         query above for why: three entries need to fit one phone screen. */
      padding-bottom: var(--space-8);
    }
  }

  @media (max-height: 700px) {
    .timeline__entry {
      /* See .experience's height-based media query above. */
      padding-bottom: var(--space-4);
    }

    .timeline__header {
      margin-bottom: var(--space-2);
    }

    .timeline__summary {
      margin-bottom: var(--space-2);
      /* Body text is the biggest chunk of this section's height (3
         multi-line summaries) — a modest reduction here recovers more
         vertical space than any of the spacing trims above on a short
         screen. */
      font-size: 0.9375rem;
      line-height: 1.5;
    }
  }

  .timeline__marker {
    position: absolute;
    left: 0;
    top: 6px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 1px solid var(--color-accent);
  }

  .timeline__header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .timeline__dates {
    color: var(--color-text-muted);
  }

  .timeline__summary {
    margin-bottom: var(--space-4);
  }

  .timeline__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .timeline__tag {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-3);
    color: var(--color-text-muted);
  }
</style>
