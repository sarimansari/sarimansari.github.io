---
// Tagline + bio used to live in Hero, but that made it feel cluttered —
// split out into their own section per direct instruction.
import site from "../data/site.json";
import SplitHeading from "./SplitHeading.astro";
---

<section class="about" id="about" data-recede>
  <div class="about__inner">
    <SplitHeading text="About" tag="h2" class="about__heading" />
    <p class="about__bio" data-reveal>{site.bio}</p>
  </div>
</section>

<style>
  .about {
    /* Every content section shares this min-height + centering (see
       Hero.astro, which established the pattern) so they read as
       consistent, roughly one-screen "beats" while scrolling, instead of
       each one's height being purely driven by how much copy it holds. */
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-24) var(--space-6);
    /* Page-by-page scroll (see html's scroll-snap-type in base.css). */
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  @media (min-width: 1024px) {
    .about {
      padding: var(--space-40) var(--space-16);
    }
  }

  .about__inner {
    /* width:100% is load-bearing now that .about is a flex column (for
       vertical centering): a flex item with margin:auto and no explicit
       width shrink-wraps to its content instead of filling the container,
       which made short-content sections (Contact, Experience) visibly
       center themselves while wider ones (About, Skills) looked left-
       aligned only because their content happened to fill the width
       anyway. Explicit width:100% + max-width restores normal block
       behavior: full width until max-width caps it, then centered. */
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .about__bio {
    /* Back to one flowing paragraph (was briefly split into a separate
       line per sentence) — sized up from body copy so it reads as a real
       statement, at full text color since it's the section's only
       content. Sentence-case here (not the site-wide lowercase aesthetic
       headings use) since this is hand-authored prose, not a UI label. */
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    line-height: 1.6;
    max-width: 720px;
    color: var(--color-text);
  }

  .about__bio::first-letter {
    /* The opening "I" as a small styled initial — display font for a
       different texture than the body serif, a bit bigger without going
       full drop-cap (no float/multi-line span). Kept modest and paired
       with line-height:1: much larger and the enlarged glyph's line box
       pushes the second line down further than the rest, reading as an
       uneven gap rather than a deliberate flourish. */
    font-family: var(--font-display);
    font-size: 1.3em;
    line-height: 1;
    font-weight: 500;
  }
</style>
