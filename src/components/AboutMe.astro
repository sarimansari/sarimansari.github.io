---
// Tagline + bio used to live in Hero, but that made it feel cluttered —
// split out into their own section per direct instruction.
import site from "../data/site.json";
---

<section class="about" id="about">
  <div class="about__inner">
    <h2 class="about__heading" data-reveal>About</h2>
    <p class="about__tagline" data-reveal>{site.tagline}</p>
    <p class="about__bio" data-reveal>{site.bio}</p>
  </div>
</section>

<style>
  .about {
    padding: var(--space-24) var(--space-6);
  }

  @media (min-width: 1024px) {
    .about {
      padding: var(--space-40) var(--space-16);
    }
  }

  .about__inner {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .about__heading {
    margin-bottom: var(--space-8);
  }

  .about__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    line-height: 1.4;
    max-width: 640px;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .about__bio {
    font-size: 1rem;
    line-height: 1.6;
    max-width: 560px;
    color: var(--color-text-muted);
  }
</style>
