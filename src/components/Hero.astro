---
// Avatar media is pending the Higgsfield stylize/animate pipeline (Section 27
// of MASTER_BUILD_PLAN.md — awaiting the uploaded source photo). Once
// src/assets/avatar/avatar.mp4 (or .webm) exists, swap the placeholder
// <div class="hero__avatar-placeholder"> below for a <video> element.
import site from "../data/site.json";

const firstName = site.name.split(" ")[0];

const greetings = [
  { word: "Hello", lang: "en" },
  { word: "Bonjour", lang: "fr" },
  { word: "Hola", lang: "es" },
  { word: "Hallo", lang: "de" },
  { word: "مرحباً", lang: "ar", dir: "rtl" },
];
---

<section class="hero" id="top">
  <div class="hero__grid">
    <div class="hero__content" data-hero-content>
      <p class="hero__greeting" data-hero-eyebrow>
        <span class="hero__wave" aria-hidden="true">👋</span>
        <span class="hero__rotator">
          {greetings.map((g) => (
            <span class="hero__rotator-word" lang={g.lang} dir={g.dir}>{g.word}</span>
          ))}
        </span>
      </p>

      <h1 class="hero__name">
        <span class="hero__word-wrap">
          <span class="hero__word" data-hero-word>{firstName}</span>
        </span>
      </h1>

      <p class="hero__subtitle meta" data-hero-subtitle>{site.subtitle}</p>

      <p class="hero__positioning" data-hero-positioning>{site.positioning}</p>
    </div>

    <div class="hero__avatar" aria-hidden="true">
      <div class="hero__avatar-placeholder">
        <span class="meta">[avatar pending]</span>
      </div>
    </div>
  </div>

  <div class="hero__scroll-cue" data-hero-scroll-cue aria-hidden="true">
    <span class="hero__scroll-line"></span>
    <span class="meta">scroll</span>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-24) var(--space-6);
    position: relative;
  }

  @media (min-width: 1024px) {
    .hero {
      padding: var(--space-24) var(--space-16);
    }
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
    max-width: 1200px;
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--space-16);
    }
  }

  .hero__content {
    max-width: 640px;
  }

  /* Vignette: subtle radial darkening toward the edges (Section 6/8) */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.08) 100%);
    pointer-events: none;
    z-index: -1;
  }

  .hero__greeting {
    opacity: 0;
    transform: translateY(16px);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .hero__wave {
    display: inline-block;
    font-size: 1.5rem;
    transform-origin: 70% 70%;
    animation: hero-wave 2.4s ease-in-out 1;
    animation-iteration-count: 3;
  }

  @keyframes hero-wave {
    0% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
    60% { transform: rotate(0deg); }
    100% { transform: rotate(0deg); }
  }

  .hero__rotator {
    position: relative;
    display: inline-block;
    height: 1.4em;
    min-width: 7ch;
  }

  .hero__rotator-word {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    opacity: 0;
    animation: hero-rotator 10s ease-in-out infinite;
  }

  .hero__rotator-word:nth-child(1) { animation-delay: 0s; }
  .hero__rotator-word:nth-child(2) { animation-delay: -8s; }
  .hero__rotator-word:nth-child(3) { animation-delay: -6s; }
  .hero__rotator-word:nth-child(4) { animation-delay: -4s; }
  .hero__rotator-word:nth-child(5) { animation-delay: -2s; }

  @keyframes hero-rotator {
    0%, 3% { opacity: 0; }
    5%, 15% { opacity: 1; }
    18%, 100% { opacity: 0; }
  }

  .hero__name {
    margin: 0 0 var(--space-6);
    overflow: hidden;
  }

  .hero__word-wrap {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
  }

  .hero__word {
    display: inline-block;
    opacity: 0;
    transform: translateY(24px);
  }

  .hero__subtitle {
    opacity: 0;
    transform: translateY(16px);
    margin-bottom: var(--space-8);
    color: var(--color-text-muted);
  }

  .hero__positioning {
    opacity: 0;
    transform: translateY(16px);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    line-height: 1.4;
    max-width: 640px;
    color: var(--color-text);
  }

  .hero__avatar {
    display: flex;
    justify-content: center;
  }

  .hero__avatar-placeholder {
    aspect-ratio: 1;
    width: 100%;
    max-width: 340px;
    border: 1px dashed var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
  }

  .hero__scroll-cue {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    opacity: 0;
  }

  .hero__scroll-line {
    width: 1px;
    height: 32px;
    background: var(--color-text-muted);
  }

  /* Reduced-motion / no-JS fallback: content is already in place, just needs opacity */
  .hero__content.is-visible .hero__greeting,
  .hero__content.is-visible .hero__word,
  .hero__content.is-visible .hero__subtitle,
  .hero__content.is-visible .hero__positioning {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__greeting,
    .hero__word,
    .hero__subtitle,
    .hero__positioning,
    .hero__scroll-cue {
      opacity: 1;
      transform: none;
    }

    .hero__wave {
      animation: none;
    }

    /* Only the first (English) greeting stays visible; no cycling. */
    .hero__rotator-word {
      animation: none;
      opacity: 0;
    }

    .hero__rotator-word:first-child {
      opacity: 1;
      position: static;
    }
  }
</style>

<script>
  import { heroEntrance, heroRecede } from "../scripts/motion.js";

  const heroSection = document.querySelector(".hero");

  heroEntrance(heroSection);
  heroRecede(heroSection);
</script>
