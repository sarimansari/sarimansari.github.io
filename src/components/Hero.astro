---
// The AI-generated (Higgsfield) avatar hit a real paywall — the workspace
// has no free credits and no one-time top-up, only paid subscriptions — so
// per direct instruction this uses the real uploaded photo instead.
// sarim-source2.png is a background-removed cutout (real alpha transparency)
// of the photo. The SVG duotone filter below (near-black shadows -> accent
// grey highlights) also incidentally fixes the source photo's blown-out
// studio-lit highlights: duotone remaps the whole luminance range through a
// 2-color lookup, so nothing can read as "glowing" the way it did when the
// photo was shown in natural color (a brightness/contrast filter was tried
// as a fix for that at the time; removed now that duotone supersedes it).
//
// Tagline/bio used to live here too, but that made the hero feel cluttered
// — they now live in AboutMe.astro as their own section.
import { Image } from "astro:assets";
import site from "../data/site.json";
import avatarSource from "../assets/avatar/sarim-source2.png";

const firstName = site.name.split(" ")[0];

const greetings = [
  { word: "Hello", lang: "en" },
  { word: "Bonjour", lang: "fr" },
  { word: "Hola", lang: "es" },
  { word: "Hallo", lang: "de" },
  { word: "مرحباً", lang: "ar", dir: "rtl" },
  { word: "你好", lang: "zh" },
  { word: "नमस्ते", lang: "hi" },
];
---

<section class="hero" id="top">
  <div class="hero__grid">
    <div class="hero__content" data-hero-content>
      <p class="hero__greeting" data-hero-eyebrow>
        <span class="hero__wave" aria-hidden="true">👋</span>
        <span class="hero__rotator">
          {greetings.map((g) => (
            <span class="hero__rotator-word" lang={g.lang} dir={g.dir}>{g.word}</span>
          ))}
        </span>
      </p>

      <h1 class="hero__name">
        {["Hi,", "I'm", firstName].map((word) => (
          <span class="hero__word-wrap">
            <span class="hero__word" data-hero-word>{word}</span>
          </span>
        ))}
      </h1>

      <p class="hero__role meta" data-hero-subtitle>
        <span class="hero__role-typed" data-hero-role-typed aria-hidden="true">{site.roles[0]}</span><span class="hero__role-cursor" aria-hidden="true"></span>
        <span class="hero__role-sr">{site.roles.join(", ")}</span>
      </p>
    </div>

    <div class="hero__avatar">
      <svg width="0" height="0" style="position:absolute">
        <filter id="hero-duotone" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.33 0.33 0.33 0 0  0.33 0.33 0.33 0 0  0.33 0.33 0.33 0 0  0 0 0 1 0" />
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.043 0.690" />
            <feFuncG type="table" tableValues="0.047 0.706" />
            <feFuncB type="table" tableValues="0.055 0.729" />
          </feComponentTransfer>
        </filter>
      </svg>
      <Image
        src={avatarSource}
        alt={`${site.name} portrait`}
        width={640}
        loading="eager"
        fetchpriority="high"
        draggable="false"
        class="hero__avatar-image"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-24) var(--space-6);
    position: relative;
  }

  @media (min-width: 1024px) {
    .hero {
      padding: var(--space-24) var(--space-16);
    }
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
    max-width: 1200px;
    /* Centered in the viewport (not flush-left) so large/ultrawide monitors
       get symmetric breathing room on both sides instead of a huge empty
       gap on the right — applied consistently across every section (see
       Skills/WhereIveWorked/Contact). Text itself stays left-aligned within
       this block; only the block's position is centered. */
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .hero__grid {
      /* Was 1.3fr 1fr — narrowed the text column to widen the avatar's
         column instead (see .hero__avatar's max-width below), since the
         avatar was maxing out at ~492px regardless of how high its own
         max-width was set. */
      grid-template-columns: 1fr 1.1fr;
      gap: var(--space-16);
    }
  }

  .hero__content {
    max-width: 640px;
  }

  /* Vignette: subtle radial darkening toward the edges (Section 6/8) */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.08) 100%);
    pointer-events: none;
    z-index: -1;
  }

  .hero__greeting {
    opacity: 0;
    transform: translateY(16px);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .hero__wave {
    display: inline-block;
    font-size: 1.5rem;
    transform-origin: 70% 70%;
    animation: hero-wave 2.4s ease-in-out 1;
    animation-iteration-count: 3;
  }

  @keyframes hero-wave {
    0% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
    60% { transform: rotate(0deg); }
    100% { transform: rotate(0deg); }
  }

  .hero__rotator {
    position: relative;
    display: inline-block;
    height: 1.4em;
    min-width: 7ch;
  }

  .hero__rotator-word {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    /* Site-wide lowercase aesthetic — safe here (no acronyms in any
       greeting; the non-Latin scripts have no case to transform anyway). */
    text-transform: lowercase;
    opacity: 0;
    /* 14s = 7 greetings x 2s each, same per-word spacing the original 5-word
       version used (10s / 5). Keyframe percentages below are the original
       0/3/5/15/18 timings rescaled by 10/14 so each word still gets the
       same ~1s of visible time regardless of how many are in the list. */
    animation: hero-rotator 14s ease-in-out infinite;
  }

  @media (min-width: 1024px) {
    .hero__rotator-word {
      font-size: 1.0625rem;
    }
  }

  .hero__rotator-word:nth-child(1) { animation-delay: 0s; }
  .hero__rotator-word:nth-child(2) { animation-delay: -12s; }
  .hero__rotator-word:nth-child(3) { animation-delay: -10s; }
  .hero__rotator-word:nth-child(4) { animation-delay: -8s; }
  .hero__rotator-word:nth-child(5) { animation-delay: -6s; }
  .hero__rotator-word:nth-child(6) { animation-delay: -4s; }
  .hero__rotator-word:nth-child(7) { animation-delay: -2s; }

  @keyframes hero-rotator {
    0%, 2% { opacity: 0; }
    4%, 11% { opacity: 1; }
    13%, 100% { opacity: 0; }
  }

  .hero__name {
    margin: 0 0 var(--space-6);
    overflow: hidden;
  }

  .hero__word-wrap {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
  }

  .hero__word {
    display: inline-block;
    opacity: 0;
    transform: translateY(24px);
    margin-right: 0.28em;
  }

  .hero__role {
    /* Sized to match .hero__rotator-word above (both are Hero's small mono
       accent lines) rather than the smaller .meta default the class still
       supplies for font-family/color/letter-spacing. */
    opacity: 0;
    transform: translateY(16px);
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  @media (min-width: 1024px) {
    .hero__role {
      font-size: 1.0625rem;
    }
  }

  /* Typed by the script below (character-by-character, then deleted and
     retyped with the next role) — deliberately a different effect than the
     greeting's plain crossfade so the two rotators don't read as the same
     animation twice. site.roles[0] is rendered server-side as the initial
     content so something sensible shows before JS runs (or if it never
     does); the script clears it and takes over once it's ready. */
  .hero__role-cursor {
    display: inline-block;
    width: 1px;
    height: 0.9em;
    margin-left: 2px;
    background: var(--color-accent);
    vertical-align: -0.1em;
    animation: hero-cursor-blink 900ms step-end infinite;
  }

  @keyframes hero-cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Visually hidden but readable by screen readers — the typed span is
     aria-hidden since its text changes constantly, so this static sentence
     is what assistive tech announces instead. */
  .hero__role-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero__avatar {
    position: relative;
    width: 100%;
    /* Real ceiling is the avatar's grid column, not this value directly
       (~595px at 1024px+, narrower on mobile's single-column layout) — set
       generously so it never clips the column, not because it's the
       actual rendered size. */
    max-width: 640px;
    aspect-ratio: 1;
    margin: 0 auto;
  }

  .hero__avatar-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* draggable="false" on the element covers most browsers; Safari needs
       -webkit-user-drag too (now set site-wide on all img in base.css),
       since it doesn't fully honor the attribute on its own — without it,
       dragging shows a ghost preview of the raw, untreated source image
       (no duotone/mask), which looks like a rendering bug. */
    object-fit: cover;
    object-position: 50% 20%;
    /* Duotone remaps the whole luminance range through a 2-color lookup
       (near-black shadows -> accent-grey highlights), which as a side
       effect also fixes the source photo's blown-out studio-lit highlights
       — nothing can read as "glowing" once it's clamped to this range. */
    filter: url(#hero-duotone);
    /* Feather the cutout's own alpha near the edges (rather than overlaying
       a flat color vignette) so it fades into --color-bg gradually instead
       of ending in a hard silhouette line. A symmetric ellipse centered in
       the box (tried first) faded the top as aggressively as the bottom,
       eating into the hair — so this ellipse is deliberately oversized and
       centered above the box (cy -31.25%). The top edge sits well inside
       the 45% inner-radius stop (hair untouched); the bottom edge lands
       around 60% of the way to the 75% outer stop, so the hoodie stays
       clearly visible with only a short, late fade right at the edge
       (a first pass here faded gradually all the way from 20%, which read
       as too gradual and erased most of the hoodie). Horizontal
       radius/position stay centered/symmetric — the sides still fade
       evenly on both edges. */
    mask-image: radial-gradient(50% 218.75% at 50% -31.25%, white 45%, transparent 75%);
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
    mask-position: center;
    -webkit-mask-image: radial-gradient(50% 218.75% at 50% -31.25%, white 45%, transparent 75%);
    -webkit-mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
  }

  /* Reduced-motion / no-JS fallback: content is already in place, just needs opacity */
  .hero__content.is-visible .hero__greeting,
  .hero__content.is-visible .hero__word,
  .hero__content.is-visible .hero__role {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__greeting,
    .hero__word,
    .hero__role {
      opacity: 1;
      transform: none;
    }

    .hero__wave {
      animation: none;
    }

    /* Only the first (English) greeting stays visible; no cycling. */
    .hero__rotator-word {
      animation: none;
      opacity: 0;
    }

    .hero__rotator-word:first-child {
      opacity: 1;
      position: static;
    }

    /* Typing is skipped entirely under reduced motion (see the script
       below) — just the static first role stays put, cursor included. */
    .hero__role-cursor {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  import { heroEntrance, heroRecede } from "../scripts/motion.js";
  import site from "../data/site.json";

  const heroSection = document.querySelector(".hero");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const typedEl = heroSection.querySelector("[data-hero-role-typed]");

  heroRecede(heroSection);

  // Hold the entrance (and the typewriter effect below) until Loader.astro
  // signals it's dissolving, instead of playing immediately on script load
  // — otherwise the whole entrance finishes underneath the opaque loader
  // and removing it just reveals an already-static page, which is the gap
  // this is closing. Reduced motion skips the loader animation entirely,
  // so start right away in that case (must happen after typedEl above is
  // initialized, since this can fire synchronously); the 2s fallback
  // covers the loader markup ever failing to fire the event for some
  // other reason.
  let started = false;
  function startHeroSequence() {
    if (started) return;
    started = true;
    heroEntrance(heroSection);
    startTypewriter();
  }

  if (prefersReducedMotion) {
    startHeroSequence();
  } else {
    window.addEventListener("site:ready", startHeroSequence, { once: true });
    setTimeout(startHeroSequence, 2000);
  }

  function startTypewriter() {
    if (!typedEl || prefersReducedMotion) return;

    const roles = site.roles;
    const TYPE_MS = 45;
    const DELETE_MS = 28;
    const HOLD_MS = 1600;
    const PAUSE_MS = 400;

    let roleIndex = 0;
    let charCount = 0;
    let deleting = false;

    typedEl.textContent = "";

    function tick() {
      const word = roles[roleIndex];

      if (!deleting) {
        charCount++;
        typedEl.textContent = word.slice(0, charCount);
        if (charCount === word.length) {
          deleting = true;
          setTimeout(tick, HOLD_MS);
          return;
        }
        setTimeout(tick, TYPE_MS);
      } else {
        charCount--;
        typedEl.textContent = word.slice(0, charCount);
        if (charCount === 0) {
          deleting = false;
          roleIndex = (roleIndex + 1) % roles.length;
          setTimeout(tick, PAUSE_MS);
          return;
        }
        setTimeout(tick, DELETE_MS);
      }
    }

    setTimeout(tick, TYPE_MS);
  }
</script>
