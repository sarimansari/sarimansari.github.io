---
import fs from "node:fs";
import path from "node:path";
import site from "../data/site.json";
import SplitHeading from "./SplitHeading.astro";

// Resume is real user content, not something to fabricate — mirrors the
// email content-gap pattern below. Drop the actual file at public/resume.pdf
// and this flips to a working download link with no code changes needed.
const resumeExists = fs.existsSync(path.resolve("public/resume.pdf"));

// LinkedIn/GitHub/Instagram moved to Hero.astro — Contact keeps only email
// and the resume download, the two things worth a dedicated final CTA.
const ICONS = {
  email:
    '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/><polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>',
  download:
    '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/><polyline points="7 10 12 15 17 10" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/><line x1="12" y1="15" x2="12" y2="3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
};
---

<section class="contact" id="contact" data-recede>
  <div class="contact__inner">
    <div class="contact__text" data-reveal>
      <SplitHeading text="Get in touch" tag="h2" class="contact__heading" />
      <p class="contact__intro" data-reveal>
        {site.contactIntro}
        {site.email && (
          <a href={`mailto:${site.email}`} class="contact__icon" aria-label="Email">
            <svg viewBox="0 0 24 24" set:html={ICONS.email} />
          </a>
        )}
      </p>

      {!site.email && (
        <p class="contact__needed meta">[CONTENT NEEDED — add a contact email to src/data/site.json]</p>
      )}

      {resumeExists ? (
        <a href="/resume.pdf" download class="contact__resume" aria-label="Download resume">
          <svg viewBox="0 0 24 24" set:html={ICONS.download} />
          Resume
        </a>
      ) : (
        <p class="contact__needed meta">[CONTENT NEEDED — add public/resume.pdf to enable the Download Resume button]</p>
      )}

      {site.availability && <p class="meta contact__availability">{site.availability}</p>}
    </div>
  </div>
</section>

<style>
  .contact {
    /* min-height + centering shared with every other content section (see
       Hero.astro / AboutMe.astro) so section heights read as consistent
       instead of purely content-driven. */
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-24) var(--space-6);
    /* Page-by-page scroll (see html's scroll-snap-type in base.css). */
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  @media (min-width: 1024px) {
    .contact {
      padding: var(--space-40) var(--space-16);
    }
  }

  .contact__inner {
    /* width:100% is load-bearing now that .contact is a flex column (for
       vertical centering) — see the matching comment in AboutMe.astro for
       why a flex item with margin:auto and no explicit width shrink-wraps
       instead of filling the container. */
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .contact__text {
    max-width: var(--container-reading);
  }

  .contact__intro {
    /* Same treatment as About's bio paragraph (font-size and color) so the
       two "real sentences on the page" sections read consistently. */
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.6;
    max-width: 560px;
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }

  .contact__needed {
    color: var(--color-warning);
    margin-bottom: var(--space-8);
  }

  .contact__icon {
    /* Sits inline at the end of .contact__intro's sentence rather than on
       its own row — vertical-align nudges it down to sit on the text
       baseline instead of the inline-box's top. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 0.85em;
    height: 0.85em;
    margin-left: var(--space-2);
    vertical-align: -0.1em;
    color: var(--color-text-muted);
  }

  .contact__icon svg {
    width: 100%;
    height: 100%;
  }

  .contact__icon:hover {
    color: var(--color-accent);
  }

  .contact__resume {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    /* Site-wide lowercase aesthetic — safe here, no acronyms in the label. */
    text-transform: lowercase;
    margin-bottom: var(--space-4);
  }

  @media (min-width: 1024px) {
    .contact__resume {
      font-size: 0.875rem;
    }
  }

  .contact__resume svg {
    width: 14px;
    height: 14px;
  }

  .contact__resume:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .contact__availability {
    margin-top: var(--space-4);
  }
</style>
