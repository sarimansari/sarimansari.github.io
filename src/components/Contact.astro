---
import site from "../data/site.json";
---

<section class="contact" id="contact">
  <div class="contact__inner">
    <p class="eyebrow" data-reveal>// 03 — contact</p>

    <div class="contact__text" data-reveal>
      <h2 class="contact__heading">Let's talk.</h2>

      {site.email ? (
        <a href={`mailto:${site.email}`} class="contact__email">{site.email}</a>
      ) : (
        <p class="contact__needed meta">[CONTENT NEEDED — add a contact email to src/data/site.json]</p>
      )}

      <div class="contact__links">
        <a href={site.github} target="_blank" rel="noreferrer" class="contact__link">GitHub ↗</a>
        <a href={site.linkedin} target="_blank" rel="noreferrer" class="contact__link">LinkedIn ↗</a>
      </div>

      {site.availability && <p class="meta contact__availability">{site.availability}</p>}
    </div>
  </div>
</section>

<style>
  .contact {
    padding: var(--space-24) var(--space-6);
  }

  @media (min-width: 1024px) {
    .contact {
      padding: var(--space-40) var(--space-16);
    }
  }

  .contact__inner {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .contact__text {
    margin-top: var(--space-8);
    max-width: var(--container-reading);
  }

  .contact__heading {
    margin-bottom: var(--space-8);
  }

  .contact__email {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 6px;
    margin-bottom: var(--space-8);
  }

  .contact__needed {
    color: var(--color-warning);
    margin-bottom: var(--space-8);
  }

  .contact__links {
    display: flex;
    gap: var(--space-8);
    margin-bottom: var(--space-4);
  }

  .contact__link {
    text-decoration: none;
    color: var(--color-text-muted);
  }

  .contact__link:hover {
    color: var(--color-accent);
  }

  .contact__availability {
    margin-top: var(--space-4);
  }
</style>
