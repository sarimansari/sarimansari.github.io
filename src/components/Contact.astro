    '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/><polyline points="7 10 12 15 17 10" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/><line x1="12" y1="15" x2="12" y2="3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
};
---

<section class="contact" id="contact" data-recede>
  <div class="contact__inner">
    <div class="contact__text" data-reveal>
      <SplitHeading text="Let's talk." tag="h2" class="contact__heading" />

      {!site.email && (
        <p class="contact__needed meta">[CONTENT NEEDED — add a contact email to src/data/site.json]</p>
      )}

      <div class="contact__links">
        {site.email && (
          <a href={`mailto:${site.email}`} class="contact__icon" aria-label="Email">
            <svg viewBox="0 0 24 24" set:html={ICONS.email} />
          </a>
        )}
        <a href={site.linkedin} target="_blank" rel="noreferrer" class="contact__icon" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" set:html={ICONS.linkedin} />
        </a>
        <a href={site.github} target="_blank" rel="noreferrer" class="contact__icon" aria-label="GitHub">
          <svg viewBox="0 0 24 24" set:html={ICONS.github} />
        </a>
        {site.instagram && (
          <a href={site.instagram} target="_blank" rel="noreferrer" class="contact__icon" aria-label="Instagram">
            <svg viewBox="0 0 24 24" set:html={ICONS.instagram} />
          </a>
        )}
      </div>

      {resumeExists ? (
        <a href="/resume.pdf" download class="contact__resume">
          <svg viewBox="0 0 24 24" set:html={ICONS.download} />
          Download Resume
        </a>
      ) : (
        <p class="contact__needed meta">[CONTENT NEEDED — add public/resume.pdf to enable the Download Resume button]</p>
      )}

      {site.availability && <p class="meta contact__availability">{site.availability}</p>}
    </div>
  </div>
</section>

<style>
  .contact {
    /* min-height + centering shared with every other content section (see
       Hero.astro / AboutMe.astro) so section heights read as consistent
       instead of purely content-driven. */
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-24) var(--space-6);
  }

  @media (min-width: 1024px) {
    .contact {
      padding: var(--space-40) var(--space-16);
    }
  }

  .contact__inner {
    /* width:100% is load-bearing now that .contact is a flex column (for
       vertical centering) — see the matching comment in AboutMe.astro for
       why a flex item with margin:auto and no explicit width shrink-wraps
       instead of filling the container. */
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .contact__text {
    max-width: var(--container-reading);
  }

  .contact__needed {
    color: var(--color-warning);
    margin-bottom: var(--space-8);
  }

  .contact__links {
    display: flex;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .contact__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    color: var(--color-text-muted);
  }

  .contact__icon svg {
    width: 100%;
    height: 100%;
  }

  .contact__icon:hover {
    color: var(--color-accent);
  }

  .contact__resume {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    /* Site-wide lowercase aesthetic — safe here, no acronyms in the label. */
    text-transform: lowercase;
    margin-bottom: var(--space-4);
  }

  @media (min-width: 1024px) {
    .contact__resume {
      font-size: 0.875rem;
    }
  }

  .contact__resume svg {
    width: 14px;
    height: 14px;
  }

  .contact__resume:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .contact__availability {
    margin-top: var(--space-4);
  }
</style>
