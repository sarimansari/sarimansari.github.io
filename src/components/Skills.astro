---
import IconTech from "./IconTech.astro";
import SplitHeading from "./SplitHeading.astro";

// Lowercase site-wide, hand-authored here rather than via CSS
// text-transform since these statements have acronyms embedded mid-sentence
// (APIs, AI, GenAI, RAG, LLM) that text-transform can't selectively spare —
// it applies uniformly to a whole text node. Tech tags (below) and "AI &
// GenAI" itself are left in their real casing entirely, same reasoning.
const groups = [
  {
    name: "backend, systems & frontend",
    statement: "backend services, APIs, and the frontend that talks to them.",
    tech: ["Java", "Spring Boot", "Microservices", "gRPC", "REST", "Angular"],
  },
  {
    name: "AI & GenAI",
    statement: "agentic AI and GenAI — RAG, LLM tooling, agent architectures.",
    tech: ["Agentic Architectures", "RAG (FAISS)", "LLaMA 3", "Spring AI", "MCP"],
  },
  {
    name: "data & messaging",
    statement: "data storage and messaging.",
    tech: ["MongoDB", "Redis", "Snowflake", "Kafka"],
  },
];
---

<section class="skills" id="skills" data-recede>
  <div class="skills__inner">
    <SplitHeading text="Skills" tag="h2" class="skills__heading" />

    <div class="skills__groups">
      {groups.map((group) => (
        <div class="skills__group" data-reveal data-reveal-group="skills">
          <h3 class="skills__group-name">{group.name}</h3>
          <p class="skills__group-statement">{group.statement}</p>
          <ul class="skills__tags">
            {group.tech.map((t) => (
              <li class="skills__tag meta">
                <IconTech name={t} />
                {t}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    /* min-height + centering shared with every other content section (see
       Hero.astro / AboutMe.astro) so section heights read as consistent
       instead of purely content-driven. 100dvh after 100vh (unsupported
       browsers just keep the 100vh rule) tracks Safari's collapsing
       address bar instead of the larger static viewport, which matters
       here because this section is one of the two most likely to overflow
       one screen on a phone. */
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-24) var(--space-6);
    /* Page-by-page scroll (see html's scroll-snap-type in base.css). */
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  @media (max-width: 767px) {
    .skills {
      /* Three stacked groups (heading + statement + tags each) plus the
         original space-24 padding routinely ran taller than one phone
         screen, so the mandatory snap landed at the top but left content
         below the fold — reaching it, then the next section, took an
         extra manual scroll. Tighter padding and top-alignment (instead
         of vertical centering, which only makes overflow worse) gets all
         three groups to fit in one view on most phones. */
      padding: var(--space-12) var(--space-4);
      justify-content: flex-start;
    }
  }

  @media (max-height: 700px) {
    .skills {
      /* Overflow here is a height problem, not a width one — a short
         phone (e.g. iPhone SE at 667px tall) still ran past one screen
         even after the max-width trim above. Targets short viewports
         specifically, independent of how wide they are. */
      padding: var(--space-8) var(--space-4);
    }
  }

  @media (min-width: 1024px) {
    .skills {
      padding: var(--space-40) var(--space-16);
    }
  }

  .skills__inner {
    /* width:100% is load-bearing now that .skills is a flex column (for
       vertical centering) — see the matching comment in AboutMe.astro for
       why a flex item with margin:auto and no explicit width shrink-wraps
       instead of filling the container. */
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .skills__groups {
    /* Tighter than the old space-12 gap: with 3 groups stacked on mobile,
       that alone added 96px, which pushed this section's content taller
       than most phone viewports — leaving no room for the vertical
       centering every section is supposed to share (see .skills above) to
       actually show, unlike shorter sections like Contact. */
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (max-width: 767px) {
    .skills__groups {
      /* See .skills's mobile media query — trimmed further so all 3
         groups fit one phone screen. */
      gap: var(--space-6);
    }
  }

  @media (max-height: 700px) {
    .skills__groups {
      /* See .skills's height-based media query above. */
      gap: var(--space-4);
    }
  }

  @media (min-width: 768px) {
    .skills__groups {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .skills__groups {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .skills__group {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
    transition: opacity 150ms ease;
  }

  @media (max-height: 700px) {
    .skills__group {
      padding-top: var(--space-2);
    }
  }

  .skills__group-name {
    /* Opts out of the global h1/h2/h3 lowercase rule (see base.css) —
       "AI & GenAI" needs to render exactly as authored above, and the
       other two names are already hand-authored lowercase themselves. */
    text-transform: none;
    margin-bottom: var(--space-2);
  }

  .skills__group-statement {
    /* No font-size override — inherits body's responsive scale, matching
       About's bio (same "supporting sentence under a heading" role). */
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  @media (max-height: 700px) {
    .skills__group-statement {
      /* Same reasoning as Where I've Worked's summary trim — body text is
         the biggest recoverable chunk of height on a short screen. */
      font-size: 0.9375rem;
      line-height: 1.5;
    }
  }

  .skills__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .skills__tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-3);
    color: var(--color-text-muted);
  }
</style>
