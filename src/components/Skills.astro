---
import IconTech from "./IconTech.astro";

const groups = [
  {
    name: "Backend, Systems & Frontend",
    statement: "Designing services that hold up under real traffic, not just demos.",
    tech: ["Java", "Spring Boot", "Microservices", "gRPC", "REST", "Angular"],
  },
  {
    name: "AI & GenAI",
    statement: "Building the AI layer as an engineer, not just calling an API.",
    tech: ["Agentic Architectures", "RAG (FAISS)", "LLaMA 3", "Spring AI", "MCP"],
  },
  {
    name: "Data & Messaging",
    statement: "Choosing the right store and the right pipe for the job.",
    tech: ["MongoDB", "Redis", "Snowflake", "Kafka"],
  },
];
---

<section class="skills" id="skills">
  <div class="skills__inner">
    <h2 class="skills__heading" data-reveal>Skills</h2>

    <div class="skills__groups">
      {groups.map((group) => (
        <div class="skills__group" data-reveal data-reveal-group="skills">
          <h3 class="skills__group-name">{group.name}</h3>
          <p class="skills__group-statement">{group.statement}</p>
          <ul class="skills__tags">
            {group.tech.map((t) => (
              <li class="skills__tag meta">
                <IconTech name={t} />
                {t}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    padding: var(--space-24) var(--space-6);
  }

  @media (min-width: 1024px) {
    .skills {
      padding: var(--space-40) var(--space-16);
    }
  }

  .skills__inner {
    /* Centered in the viewport, consistently with every other section (see
       Hero.astro for the full rationale) — large monitors get symmetric
       whitespace instead of everything crammed against the left edge. Text
       itself stays left-aligned within this block. */
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .skills__heading {
    margin: 0 0 var(--space-16);
  }

  .skills__groups {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }

  @media (min-width: 768px) {
    .skills__groups {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .skills__groups {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .skills__group {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-6);
    transition: opacity 150ms ease;
  }

  .skills__group-name {
    margin-bottom: var(--space-2);
  }

  .skills__group-statement {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin-bottom: var(--space-4);
  }

  .skills__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .skills__tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-3);
    color: var(--color-text-muted);
  }
</style>
